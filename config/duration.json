    "after_steal": {
      "mode": "TRANSITION",
      "align_extra_seconds": 0
    },
    "after_turnover": {
      "mode": "TRANSITION",
      "align_extra_seconds": 0
    },
    "after_offensive_rebound": {
      "mode": "HALFCOURT",
      "align_extra_seconds": 0,
      "shot_clock_reset_to": 14
    },
    "after_inbound": {
      "mode": "HALFCOURT",
      "align_extra_seconds": 0
    },
    "after_jump_ball": {
      "mode": "HALFCOURT",
      "align_extra_seconds": 0
    }
