{
  "foundation_version": "0.13.0",
  "resolution_seconds": 0.1,
  "quantize_rule": "Math.round(delta_raw * 10) / 10",
  "clocks": {
    "period_seconds": 720,
    "overtime_seconds": 300,
    "shot_clock_full": 24,
    "shot_clock_reset": 14,
    "backcourt_seconds": 8
